conn = http.client.HTTPConnection("api.mediastack.com")

keywords = "veganism"

params = urllib.parse.urlencode(
    {
        "access_key": "8160f7346c120151ee235953a46cb6ad",  ## YOUR ACCESS KEY
        "keywords": keywords,
        "sort": "published_desc",
        "languages": "en",
        "limit": 100,
    }
)

conn.request("GET", "/v1/news?{}".format(params))

res = conn.getresponse()
